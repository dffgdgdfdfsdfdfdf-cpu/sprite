# Copy this file to .env and replace every placeholder before running the server.
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
# Bootstrap is used only when the admins table is empty. The first login must change this password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Production: set a persistent 32-byte key encoded as 64 hex characters.
# Development creates and preserves .private/bank-details-key automatically.
BANK_DETAILS_ENCRYPTION_KEY=
